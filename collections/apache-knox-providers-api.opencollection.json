{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apache Knox Admin REST Descriptors Providers API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apache knox Apache Knox List Provider Configs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://localhost:8443/gateway/admin/api/v1/providerconfig"
          },
          "docs": "List all provider configurations."
        },
        {
          "info": {
            "name": "Apache knox Apache Knox Create Provider Config",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://localhost:8443/gateway/admin/api/v1/providerconfig",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new provider configuration."
        }
      ]
    }
  ],
  "bundled": true
}